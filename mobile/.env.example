# Backend base URL, including the API version. The client calls
# `/competitions/:id` relative to this, so `/api/v1` must be part of it.
#
#   iOS simulator / web : http://localhost:4000/api/v1
#   Android emulator    : http://10.0.2.2:4000/api/v1
#   Physical device     : http://<your-lan-ip>:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The user the app is acting as. Sent as the `x-user-id` header.
# Get a valid 24-character ObjectId from `npm run seed` in ../server.
EXPO_PUBLIC_DEV_USER_ID=

# Which competition `/` redirects to. `src/app/index.tsx` forwards here so the
# app opens on the real screen rather than an unmatched route. Same seed script
# prints this id.
EXPO_PUBLIC_DEV_COMPETITION_ID=
